
import express from "express";
import { Bot } from "grammy";
import crypto from "node:crypto";

const app = express();
app.use(express.json());

const PORT = process.env.PORT || 3000;
const BOT_TOKEN = process.env.BOT_TOKEN;

if (!BOT_TOKEN) {
  throw new Error("BOT_TOKEN is missing");
}

const bot = new Bot(BOT_TOKEN);

// Временное хранилище для тестирования.
// Позже заменим его постоянной базой данных.
const users = new Map();
const codes = new Map();

function createNumber() {
  return "SG" + crypto.randomInt(10000, 99999);
}

bot.command("start", async (ctx) => {
  const telegramId = String(ctx.from.id);

  let user = users.get(telegramId);

  if (!user) {
    user = { number: createNumber() };
    users.set(telegramId, user);
  }

  await ctx.reply(
    `Добро пожаловать в StarGram!\n\nТвой номер: ${user.number}\n\nСохрани его для входа.`
  );
});

app.post("/request-code", async (req, res) => {
  const { number, telegramId } = req.body;

  if (!number || !telegramId) {
    return res.status(400).json({ error: "Missing data" });
  }

  const user = users.get(String(telegramId));

  if (!user || user.number !== number) {
    return res.status(401).json({ error: "Invalid account" });
  }

  const code = String(crypto.randomInt(10000, 100000));

  codes.set(number, {
    code,
    expires: Date.now() + 5 * 60 * 1000
  });

  await bot.api.sendMessage(
    telegramId,
    `Твой код входа в StarGram: ${code}\nКод действует 5 минут. Никому его не сообщай.`
  );

  res.json({ success: true });
});

app.post("/verify-code", (req, res) => {
  const { number, code } = req.body;
  const saved = codes.get(number);

  if (
    !saved ||
    saved.expires < Date.now() ||
    saved.code !== String(code)
  ) {
    return res.status(401).json({ error: "Invalid or expired code" });
  }

  codes.delete(number);
  res.json({ success: true });
});

app.get("/", (req, res) => {
  res.send("StarGram server is running");
});

bot.start();

app.listen(PORT, () => {
  console.log(`StarGram server started on port ${PORT}`);
});
